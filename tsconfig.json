{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "strict": true,
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/assets/*": [
                "./assets/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "modules/**/*.ts",
        "app.config.ts",
        ".expo/types/**/*.ts",
        "expo-env.d.ts"
    ]
}

# Local example auth server. Use your Mac's LAN IP for a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Node.js 22.13+ example auth server (bun run dev:api)
AUTH_PORT=3001
AUTH_HOST=0.0.0.0
AUTH_PUBLIC_BASE_URL=http://localhost:3001
AUTH_DEMO_EMAIL=demo@jeupjeup.local
AUTH_DEMO_PASSWORD=Jeupjeup123!

# Server-only Google web OAuth credentials. Register this origin's
# /api/auth/oauth/google/callback in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao numeric app ID, used by the server to verify the token's app.
# This is different from the native app key KAKAO_CID below.
KAKAO_APP_ID=

# Native SDK configuration, read during prebuild/build. Use this app's credentials.
# Do not use the Kakao REST API key; this must be the native app key.
KAKAO_CID=
NAVER_CID=
NAVER_CLIENT_SECRET=

# Defaults to the deployed API. Override for local development:
# iOS: http://127.0.0.1:8000/api; Android emulator: http://10.0.2.2:8000/api.
EXPO_PUBLIC_API_URL=https://jeupjeup-api.pro203s.kr/api
JUPJUP_API_HOST=127.0.0.1
JUPJUP_API_PORT=8000
# Share one SQLite database between API, worker, app and web.
# JUPJUP_DB_PATH=/absolute/path/to/jupjup.db

# Set live/local to use an installed GGUF model. Missing models fail explicitly.
JUPJUP_MODE=live
JUPJUP_EMBEDDING_BACKEND=hashing
JUPJUP_ANALYZER__ENGINE=local
JUPJUP_ANALYZER__PROFILE=tuning-qwen25-7b
# Set true to refuse startup if the configured LLM is unavailable.
JUPJUP_ANALYZER__REQUIRED=false

# Server-only OAuth. Web callback: <OAUTH_PUBLIC_ORIGIN>/api/auth/oauth/{provider}/callback
OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:5177
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=
# Native Google callback: <API_PUBLIC_ORIGIN>/api/auth/oauth/google/native-callback
API_PUBLIC_ORIGIN=http://127.0.0.1:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_APP_ID=
# Native SDK build-time credentials
KAKAO_CID=
NAVER_CID=
NAVER_CLIENT_SECRET=
